@page "/vocabularies"
@rendermode InteractiveServer
@using Vocabi.Web.ViewModels.Vocabularies
@using Vocabi.Shared.Utils
@using Vocabi.Web.Components.Vocabularies

<PageTitle>Vocabulary</PageTitle>

<FluentStack Orientation="Orientation.Vertical">
    <FluentStack HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center">
        <FluentStack VerticalAlignment="VerticalAlignment.Center">
            <FluentLabel Typo="Typography.H3">
                Vocabulary
            </FluentLabel>
        </FluentStack>
        <FluentStack VerticalAlignment="VerticalAlignment.Center" Width="auto">
            <FluentButton Appearance="Appearance.Accent"
                          IconStart="@(new Icons.Regular.Size16.Add())"
                          OnClick="OpenCreateDialogAsync">
                Create
            </FluentButton>
        </FluentStack>
    </FluentStack>

    <FluentStack HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center">
        <FluentSearch @bind-Value="searchWord"
                      @bind-Value:after="RefreshDataAsync"
                      Immediate="true"
                      ImmediateDelay="500"
                      Placeholder="Search for word"
                      Style="flex:1;" />
        <FluentStack Width="auto">
            @switch (Status)
            {
                case VocabularyStatus.Pending:
                    <VocabularyActionButton OnClick="() => { }"
                                            IsLoading="isDeletingMultiple"
                                            Disabled="!selectedItems.Any()"
                                            BackgroundColor="var(--error)"
                                            Color="var(--neutral-fill-rest)"
                                            Icon="@(new Icons.Regular.Size16.Delete())"
                                            SelectedCount="selectedItems.Count()"
                                            ActionText="Delete" />

                    <VocabularyActionButton OnClick="HandleExportMultipleAsync"
                                            IsLoading="isExportingMultiple"
                                            Disabled="!selectedItems.Any()"
                                            BackgroundColor="#16a34a"
                                            Color="var(--neutral-fill-rest)"
                                            Icon="@(new Icons.Regular.Size16.ArrowExport())"
                                            SelectedCount="selectedItems.Count()"
                                            ActionText="Export" />
                    break;

                case VocabularyStatus.Exported:
                    <VocabularyActionButton OnClick="HandleRemoveExportMultipleAsync"
                                            IsLoading="isRemovingExportMultiple"
                                            Disabled="!selectedItems.Any()"
                                            BackgroundColor="var(--error)"
                                            Color="var(--neutral-fill-rest)"
                                            Icon="@(new Icons.Regular.Size16.ArrowUndo())"
                                            SelectedCount="selectedItems.Count()"
                                            ActionText="Remove export" />
                    break;

                case VocabularyStatus.Failed:
                    <VocabularyActionButton OnClick="HandleRetryExportMultipleAsync"
                                            IsLoading="isRetryingExportMultiple"
                                            Disabled="!selectedItems.Any()"
                                            BackgroundColor="#16a34a"
                                            Color="var(--neutral-fill-rest)"
                                            Icon="@(new Icons.Regular.Size16.ArrowExport())"
                                            SelectedCount="selectedItems.Count()"
                                            ActionText="Retry export" />
                    break;
            }
        </FluentStack>
    </FluentStack>

    <FluentStack Orientation="Orientation.Vertical" Style="padding-top:10px">
        <FluentDataGrid @ref="dataGrid"
                        Pagination="pagination"
                        TGridItem="VocabularyDetailViewModel"
                        Items="@dataGridItems.AsQueryable()"
                        RefreshItems="RefreshItemsAsync"
                        Loading="isRefreshing"
                        GenerateHeader="GenerateHeaderOption.Sticky"
                        DisplayMode="DataGridDisplayMode.Table"
                        OnRowDoubleClick="HandleDoubleClickRow"
                        AutoFit="true"
                        ShowHover="true"
                        Style="width:100%;">
            <ChildContent>
                <SelectColumn TGridItem="VocabularyDetailViewModel"
                              SelectMode="DataGridSelectMode.Multiple"
                              SelectFromEntireRow="false"
                              Property="@(e => e.IsSelected)"
                              OnSelect="@(e => e.Item.IsSelected = e.Selected)"
                              SelectAll="@(dataGridItems.All(p => p.IsSelected))"
                              SelectAllChanged="@(all => dataGridItems.ToList().ForEach(p => p.IsSelected = (all == true)))" />
                <PropertyColumn Property="@(c => c.Word)" />
                <PropertyColumn Property="@(c => c.PartOfSpeech)" Title="Part of speech" />
                <PropertyColumn Property="@(c => c.Pronunciation)" />
                <PropertyColumn Property="@(c => c.Cloze)" />
                <PropertyColumn Property="@(c => c.Meaning)" />
                <TemplateColumn Title="Actions" Align="@Align.Center">
                    <FluentButton Title="View"
                                  OnClick="() => Navigation.GoToVocabularyDetail(context.Id)"
                                  IconEnd="@(new Icons.Regular.Size20.Eye())" />
                    @switch (Status)
                    {
                        case VocabularyStatus.Pending:
                            <FluentButton Title="Edit"
                                          OnClick="() => OpenEditDialogAsync(context)">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Edit())" Color="Color.Warning" />
                            </FluentButton>
                            <FluentButton Title="Delete"
                                          OnClick="() => OpenDeleteDialogAsync(context)">
                                <FluentIcon Value="@(new Icons.Regular.Size16.Delete())" Color="Color.Error" />
                            </FluentButton>
                            <FluentButton Title="Export"
                                          OnClick="() => HandleExportAsync(context)"
                                          Loading="context.IsExporting"
                                          Disabled="isExportingMultiple && context.IsSelected">
                                <FluentIcon Value="@(new Icons.Regular.Size16.ArrowExport())"
                                            Color="Color.Custom"
                                            CustomColor="#16a34a" />
                            </FluentButton>
                            break;
                        case VocabularyStatus.Exported:
                            <FluentButton Title="Remove export"
                                          OnClick="() => HandleRemoveExportAsync(context)"
                                          Loading="context.IsRemovingExport"
                                          Disabled="isRemovingExportMultiple && context.IsSelected">
                                <FluentIcon Value="@(new Icons.Regular.Size16.ArrowUndo())" Color="Color.Error" />
                            </FluentButton>
                            break;
                        case VocabularyStatus.Failed:
                            <FluentButton Title="Retry export"
                                          OnClick="() => HandleRetryExportAsync(context)"
                                          Loading="context.IsRetryingExport"
                                          Disabled="isRetryingExportMultiple && context.IsSelected">
                                <FluentIcon Value="@(new Icons.Regular.Size16.ArrowClockwise())"
                                            Color="Color.Custom"
                                            CustomColor="#16a34a" />
                            </FluentButton>
                            break;
                    }
                </TemplateColumn>
            </ChildContent>
            <EmptyContent>
                <FluentStack Orientation="Orientation.Horizontal"
                             HorizontalAlignment="HorizontalAlignment.Center"
                             VerticalAlignment="VerticalAlignment.Center"
                             HorizontalGap="10">
                    <FluentIcon Value="@(new Icons.Filled.Size24.Crown())" Color="@Color.Accent" />
                    <div>Nothing to see here. Carry on!</div>
                </FluentStack>
            </EmptyContent>
        </FluentDataGrid>
        <FluentPaginator State="pagination" Style="width:100%;margin-top:0" />
    </FluentStack>
</FluentStack>