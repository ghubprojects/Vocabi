{
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [ "Serilog.Sinks.Seq" ],
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "Vocabi"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=5432;Database=vocabi;Uid=postgres;Pwd=123456;"
  },
  "PixabaySettings": {
    "ApiKey": "51032163-9d5d24106a94b1114900118f6",
    "BaseUrl": "https://pixabay.com/api/",
    "Language": "en",
    "ImageType": "photo",
    "PerPage": 5
  },
  "PerformanceSettings": {
    "ThresholdMilliseconds": 500,
    "EnableTracing": false
  },

  "DictionaryService": {
    "Database": {
      "Provider": "postgresql",
      "ConnectionString": "Server=localhost;Port=5432;Database=vocabi_dev;Uid=postgres;Pwd=123456;",
      "InitMode": "RecreateAndSeed"
    },
    "DictionaryScraping": {
      "Provider": "Cambridge",
      "BaseUrl": "https://dictionary.cambridge.org/dictionary/english"
    }
  },
  "VocabularyService": {
    "Database": {
      "Provider": "postgresql",
      "ConnectionString": "Server=localhost;Port=5432;Database=vocabi_dev;Uid=postgres;Pwd=123456;",
      "InitMode": "RecreateAndSeed"
    }
  },
  "MediaService": {
    "Storage": {
      "Container": "media",
      "ConnectionString": "UseDevelopmentStorage=true"
    }
  }
}
